# App
PORT=5000
MONGO_URI=
JWT_SECRET=

# Firebase Admin (required for push notifications)
# You can use lowercase keys exactly as requested.
project_id=
private_key_id=
private_key=
client_email=
client_id=
client_x509_cert_url=

# Optional uppercase aliases (if you prefer)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_CLIENT_X509_CERT_URL=

# Important for private_key:
# Replace line breaks with \n in .env value.
# Example:
# private_key="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
