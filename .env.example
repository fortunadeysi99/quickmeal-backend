# App
PORT=5000
MONGO_URI=
JWT_SECRET=

# Firebase Admin (required for push notifications)
# The backend supports 3 formats:
# 1) Railway-safe: full service account JSON in one line
# 2) Railway-safe: private key in base64
# 3) Classic .env: PEM private key with \n line breaks

# Option A: full service account JSON (recommended for Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","client_x509_cert_url":"..."}

# Option B: base64 encoded private key
# FIREBASE_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JSUV2Li4uCi0tLS0tRU5EIFBSSVZBVEUgS0VZLS0tLS0t

# Option C: separate env values
project_id=
private_key_id=
private_key=
client_email=
client_id=
client_x509_cert_url=

# Optional uppercase aliases (if you prefer)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_CLIENT_X509_CERT_URL=

# If you use Option C, store the PEM key on one line and escape line breaks as \n:
# private_key="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
